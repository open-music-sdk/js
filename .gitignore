# Apple private keys: the contents belong in the environment, never in the repository
*.p8
.DS_Store

# codegen: raw Apple documentation pages are cached locally, never committed
codegen/**/.cache/

# docs: the reference is generated by TypeDoc on every build, and VitePress keeps a cache
apps/docs/reference/
apps/docs/.vitepress/cache/
apps/docs/.vitepress/.temp/
