{
  "name": "@open-music-sdk/browser",
  "version": "0.0.0",
  "description": "The Apple Music API for a page: a client that fetches its developer token from your server, with the catalog, the library and the playlist verbs on it, Apple's sign-in run for you, the preview player, and the rest of the family from one import. No signing code.",
  "license": "MIT",
  "keywords": [
    "apple-music-api",
    "apple-music",
    "musickit",
    "typescript",
    "sdk",
    "browser",
    "sign-in",
    "preview",
    "player"
  ],
  "homepage": "https://github.com/open-music-sdk/js/tree/main/integrations/browser#readme",
  "bugs": "https://github.com/open-music-sdk/js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-music-sdk/js.git",
    "directory": "integrations/browser"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown --sourcemap",
    "prepack": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "test": "vitest run"
  },
  "dependencies": {
    "@open-music-sdk/client-catalog": "workspace:^",
    "@open-music-sdk/client-user": "workspace:^",
    "@open-music-sdk/core": "workspace:^",
    "@open-music-sdk/developer-token": "workspace:^",
    "@open-music-sdk/lib-playlists": "workspace:^",
    "@open-music-sdk/lib-preview-player": "workspace:^",
    "@open-music-sdk/types": "workspace:*",
    "@open-music-sdk/user-token": "workspace:^",
    "@open-music-sdk/util-artwork": "workspace:^",
    "@open-music-sdk/validate": "workspace:^"
  },
  "devDependencies": {
    "@open-music-sdk/server": "workspace:*",
    "@types/node": "catalog:",
    "jose": "catalog:",
    "tooling-tsdown-config": "workspace:*",
    "tooling-vitest-config": "workspace:*",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
