{
  "name": "@open-music-sdk/react",
  "version": "1.0.0",
  "description": "The Apple Music API for a React app: everything in the browser package, a provider that holds the client and the listener's token, hooks for the client, Apple's sign-in and the preview player, and one query factory for TanStack Query.",
  "license": "MIT",
  "keywords": [
    "apple-music-api",
    "apple-music",
    "musickit",
    "typescript",
    "sdk",
    "react",
    "hooks",
    "tanstack-query"
  ],
  "homepage": "https://github.com/open-music-sdk/js/tree/main/integrations/react#readme",
  "bugs": "https://github.com/open-music-sdk/js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-music-sdk/js.git",
    "directory": "integrations/react"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown --sourcemap",
    "prepack": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "test": "vitest run"
  },
  "dependencies": {
    "@open-music-sdk/browser": "workspace:^",
    "@open-music-sdk/client-catalog": "workspace:^",
    "@open-music-sdk/client-user": "workspace:^",
    "@open-music-sdk/core": "workspace:^",
    "@open-music-sdk/lib-preview-player": "workspace:^"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tooling-tsdown-config": "workspace:*",
    "tooling-vitest-config": "workspace:*",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
