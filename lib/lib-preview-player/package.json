{
  "name": "@open-music-sdk/lib-preview-player",
  "version": "0.0.0",
  "description": "A queue player for the preview clips of the Apple Music API: play, pause, next, previous, seek and volume around one audio element. Browser side, no framework.",
  "license": "MIT",
  "keywords": [
    "apple-music-api",
    "apple-music",
    "musickit",
    "typescript",
    "sdk",
    "preview",
    "audio",
    "player"
  ],
  "homepage": "https://github.com/open-music-sdk/js/tree/main/lib/lib-preview-player#readme",
  "bugs": "https://github.com/open-music-sdk/js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-music-sdk/js.git",
    "directory": "lib/lib-preview-player"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown --sourcemap",
    "prepack": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "test": "vitest run"
  },
  "dependencies": {
    "@open-music-sdk/core": "workspace:^"
  },
  "devDependencies": {
    "@open-music-sdk/types": "workspace:*",
    "@types/node": "catalog:",
    "tooling-tsdown-config": "workspace:*",
    "tooling-vitest-config": "workspace:*",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
