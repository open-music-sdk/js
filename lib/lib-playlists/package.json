{
  "name": "@open-music-sdk/lib-playlists",
  "version": "1.0.0",
  "description": "Playlists for the Apple Music API, where a playlist can only be made and added to: resolve tracks to the catalog, read a playlist, plan what is missing and append it. Developer token and Music User Token.",
  "license": "MIT",
  "keywords": [
    "apple-music-api",
    "apple-music",
    "musickit",
    "typescript",
    "sdk",
    "playlists",
    "isrc",
    "import",
    "sync"
  ],
  "homepage": "https://github.com/open-music-sdk/js/tree/main/lib/lib-playlists#readme",
  "bugs": "https://github.com/open-music-sdk/js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-music-sdk/js.git",
    "directory": "lib/lib-playlists"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown --sourcemap",
    "prepack": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "test": "vitest run"
  },
  "dependencies": {
    "@open-music-sdk/client-catalog": "workspace:^",
    "@open-music-sdk/client-user": "workspace:^",
    "@open-music-sdk/core": "workspace:^",
    "@open-music-sdk/types": "workspace:*"
  },
  "devDependencies": {
    "@open-music-sdk/lib-preview-player": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tooling-tsdown-config": "workspace:*",
    "tooling-vitest-config": "workspace:*",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
