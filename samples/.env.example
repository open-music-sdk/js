# The three values every server sample reads, under the names the CLI and the docs use. Copy this file to
# express-server/.env, worker-server/.env or web-nextjs/.env.local, and fill it in. Never commit the copy. Wrangler
# reads .env when there is no .dev.vars, and the Vite pages' dev server refuses to serve a file named .env, where it
# would serve .dev.vars.
#
# The key is the contents of your AuthKey_XXXXXXXXXX.p8, on one line with each line break written as \n.
APPLE_MUSIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APPLE_MUSIC_TEAM_ID="ABCDE12345"
APPLE_MUSIC_KEY_ID="ABC123DEFG"

# The page the developer token is bound to: the page samples' address. A server refuses to start without it, so
# that a copy deployed elsewhere cannot go on minting tokens for this one.
PAGE_ORIGIN="http://localhost:2728"
