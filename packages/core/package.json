{
  "name": "@open-music-sdk/core",
  "version": "0.0.0",
  "description": "Fetch-based client core for the Apple Music API: tagged errors, retry, rate limiting, pagination. Zero dependencies.",
  "license": "MIT",
  "keywords": [
    "apple-music-api",
    "apple-music",
    "musickit",
    "typescript",
    "sdk",
    "api-client",
    "fetch",
    "retry",
    "rate-limit",
    "pagination"
  ],
  "homepage": "https://github.com/open-music-sdk/js/tree/main/packages/core#readme",
  "bugs": "https://github.com/open-music-sdk/js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-music-sdk/js.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown --sourcemap",
    "prepack": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "test": "vitest run"
  },
  "dependencies": {
    "@open-music-sdk/types": "workspace:*"
  },
  "devDependencies": {
    "tooling-tsdown-config": "workspace:*",
    "tooling-vitest-config": "workspace:*",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
