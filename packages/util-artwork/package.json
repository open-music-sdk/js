{
  "name": "@open-music-sdk/util-artwork",
  "version": "0.0.0",
  "description": "Artwork URLs for the Apple Music API: fill in the {w}x{h} template and build a srcset. Zero dependencies.",
  "license": "MIT",
  "keywords": [
    "apple-music-api",
    "apple-music",
    "musickit",
    "typescript",
    "sdk",
    "artwork",
    "srcset",
    "responsive-images"
  ],
  "homepage": "https://github.com/open-music-sdk/js/tree/main/packages/util-artwork#readme",
  "bugs": "https://github.com/open-music-sdk/js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-music-sdk/js.git",
    "directory": "packages/util-artwork"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown --sourcemap",
    "prepack": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@open-music-sdk/types": "workspace:*",
    "tooling-tsdown-config": "workspace:*",
    "tooling-vitest-config": "workspace:*",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
