{
  "name": "@open-music-sdk/developer-token",
  "version": "0.0.0",
  "description": "Developer tokens for the Apple Music API: sign one with jose, or get a provider that mints or fetches them and keeps them fresh.",
  "license": "MIT",
  "keywords": [
    "apple-music-api",
    "apple-music",
    "musickit",
    "typescript",
    "sdk",
    "developer-token",
    "jwt",
    "es256",
    "jose"
  ],
  "homepage": "https://github.com/open-music-sdk/js/tree/main/packages/developer-token#readme",
  "bugs": "https://github.com/open-music-sdk/js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-music-sdk/js.git",
    "directory": "packages/developer-token"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fetcher": {
      "types": "./dist/fetcher.d.ts",
      "default": "./dist/fetcher.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "test": "vitest run"
  },
  "dependencies": {
    "@open-music-sdk/core": "workspace:^",
    "jose": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tooling-tsdown-config": "workspace:*",
    "tooling-vitest-config": "workspace:*",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
