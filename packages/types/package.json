{
  "name": "@open-music-sdk/types",
  "version": "0.0.0",
  "description": "Generated TypeScript types for the Apple Music API. Zero dependencies, declarations only.",
  "license": "MIT",
  "keywords": [
    "apple-music-api",
    "apple-music",
    "musickit",
    "typescript",
    "sdk",
    "types",
    "typescript-types",
    "typings"
  ],
  "homepage": "https://github.com/open-music-sdk/js/tree/main/packages/types#readme",
  "bugs": "https://github.com/open-music-sdk/js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-music-sdk/js.git",
    "directory": "packages/types"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown --sourcemap",
    "prepack": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --flag unstable_native_nodejs_ts_config ."
  },
  "devDependencies": {
    "tooling-tsdown-config": "workspace:*",
    "tsdown": "catalog:"
  }
}
