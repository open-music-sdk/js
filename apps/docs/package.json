{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "description": "The docs site: guides, concepts, and the reference generated by TypeDoc from the doc comments, built with VitePress and published to GitHub Pages from main.",
  "type": "module",
  "scripts": {
    "build": "typedoc && vitepress build && node check-anchors.mjs && node check-snippets.mjs",
    "dev": "typedoc && vitepress dev",
    "check": "typedoc --emit none",
    "lint": "eslint --flag unstable_native_nodejs_ts_config ."
  },
  "devDependencies": {
    "@open-music-sdk/browser": "workspace:*",
    "@open-music-sdk/client-catalog": "workspace:*",
    "@open-music-sdk/client-user": "workspace:*",
    "@open-music-sdk/core": "workspace:*",
    "@open-music-sdk/developer-token": "workspace:*",
    "@open-music-sdk/lib-playlists": "workspace:*",
    "@open-music-sdk/lib-preview-player": "workspace:*",
    "@open-music-sdk/react": "workspace:*",
    "@open-music-sdk/server": "workspace:*",
    "@open-music-sdk/types": "workspace:*",
    "@open-music-sdk/user-token": "workspace:*",
    "@open-music-sdk/util-artwork": "workspace:*",
    "@open-music-sdk/validate": "workspace:*",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "typescript": "catalog:",
    "vitepress": "catalog:"
  }
}
